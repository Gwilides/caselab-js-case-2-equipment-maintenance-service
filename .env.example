# Server configuration
PORT=3000
NODE_ENV=development

# Database configuration (PostgreSQL 16 & Sequelize)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=caselab_db
DB_USER=caselab_user
DB_PASSWORD=caselab_secret
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000
DB_LOGGING=false

# Test Database configuration
DB_NAME_TEST=caselab_db_test

# Security policies & CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Weather service (Case 1 integration)
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast
REQUEST_TIMEOUT_MS=5000

# Outdoor work suitability thresholds
OUTDOOR_MAX_WIND_SPEED=12.0
OUTDOOR_MAX_PRECIPITATION=1.0
OUTDOOR_MIN_TEMP=-15.0
OUTDOOR_MAX_TEMP=35.0

# Logging
LOG_LEVEL=info

# Optional authentication for mutating operations (bonus)
API_KEY=
